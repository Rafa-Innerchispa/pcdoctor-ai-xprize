NODE_ENV=development
PORT=8080
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Safe defaults
DEMO_MODE=true
OUTBOUND_ENABLED=false
INVOICING_ENABLED=false
EVENT_STORE=memory

# Required for non-demo write endpoints
API_ADMIN_KEY=replace-with-a-long-random-secret

# Vertex AI / Gemini
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=pcdoctor-ai-xprize-2026
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-2.5-flash

# Optional Firestore persistence
FIRESTORE_DATABASE=(default)

# Evolution API is not enabled by the application until explicitly approved
EVOLUTION_BASE_URL=
EVOLUTION_API_KEY=
