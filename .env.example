NODE_ENV=development
PORT=8080
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Safe defaults
DEMO_MODE=true
OUTBOUND_ENABLED=false
INVOICING_ENABLED=false
EVENT_STORE=memory

# Identity (enable only with a configured Firebase / Identity Platform project)
AUTH_ENABLED=false
BOOTSTRAP_OWNER_EMAIL=owner@example.invalid
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_APP_ID=

# Required for non-demo write endpoints
API_ADMIN_KEY=replace-with-a-long-random-secret

# Vertex AI / Gemini
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=pcdoctor-ai-xprize-2026
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-2.5-flash

# Optional Firestore persistence
FIRESTORE_DATABASE=(default)

# Optional authorized Ecuador tax registry. Credentials belong in Secret Manager.
RUC_API_LIVE_ENABLED=false
RUC_API_TOKEN_BASE_URL=
RUC_API_LOOKUP_BASE_URL=
RUC_API_USERNAME=
RUC_API_PASSWORD=
RUC_API_TIMEOUT_MS=8000
RUC_API_CACHE_TTL_MS=900000

# Evolution API is not enabled by the application until explicitly approved
EVOLUTION_BASE_URL=
EVOLUTION_API_KEY=
